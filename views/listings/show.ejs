<% layout("/layouts/boilerplate") %>

<div class="mt-2 mb-5">
    <h1 class="show-title"><%= listing.title %></h1>
    <p class="show-location">
        <i class="fa-solid fa-location-dot me-1"></i>
        <%= listing.location %>, <%= listing.country %>
    </p>

    <img src="<%= listing.image.url %>" class="show-hero" alt="<%= listing.title %>">

    <div class="show-layout">
        <div>
            <div class="show-host d-flex align-items-center gap-3">
                <div class="host-avatar" style="width: 50px; height: 50px; background-color: #222; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: bold;">
                    <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : "U" %>
                </div>
                <div>
                    <div>Hosted by <span><%= listing.owner ? listing.owner.username : "Unknown" %></span></div>
                    <div style="font-size: 0.85rem; color: var(--muted); font-weight: 400;">Superhost · Joined <%= listing._id.getTimestamp().toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
                </div>
            </div>
            <hr class="my-4">
            <p class="show-description"><%= listing.description %></p>
            <hr class="my-4">

            <% if (currUser) { %>
                <div class="review-section">
                    <h4>Leave a review</h4>
                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                        <div class="mb-3">
                            <label class="form-label">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />
                                <input type="radio" id="rate1" name="review[rating]" value="1" />
                                <label for="rate1">1 star</label>
                                <input type="radio" id="rate2" name="review[rating]" value="2" />
                                <label for="rate2">2 stars</label>
                                <input type="radio" id="rate3" name="review[rating]" value="3" />
                                <label for="rate3">3 stars</label>
                                <input type="radio" id="rate4" name="review[rating]" value="4" />
                                <label for="rate4">4 stars</label>
                                <input type="radio" id="rate5" name="review[rating]" value="5" />
                                <label for="rate5">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Comments</label>
                            <textarea name="review[comment]" rows="4" class="form-control" required></textarea>
                            <div class="invalid-feedback">Please add some comments</div>
                        </div>
                        <button class="btn btn-brand">Submit review</button>
                    </form>
                </div>
            <% } %>
        </div>

        <aside class="price-panel">
            <p class="mb-1">
                <span class="price-amount">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                <span class="price-night"> / night</span>
            </p>
            <p class="text-muted small mb-0">+18% GST may apply</p>

            <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <div class="panel-actions">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-brand">Edit listing</a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-ghost w-100">Delete</button>
                    </form>
                </div>
            <% } %>
        </aside>
    </div>

    <% if (listing.reviews.length > 0) { %>
        <hr class="my-5">
        <div class="review-section mt-0 pt-0 border-0">
            <h4><i class="fa-solid fa-star me-2"></i><%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %></h4>
            <div class="row">
                <% for (let review of listing.reviews) { %>
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 review-card">
                            <div class="card-body p-4">
                                <h5 class="card-title">
                                    <%= review.author ? review.author.username : "Anonymous" %>
                                </h5>
                                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                                <p class="card-text"><%= review.comment %></p>
                                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                        <button class="btn btn-sm btn-ghost">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>
</div>
