<% layout("/layouts/boilerplate") %>

<div id="filters-wrapper">
    <div id="filters">
        <a href="/listings" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta === 'undefined' || !pageMeta.categoryQuery ? 'active' : '' %>">
                <div><i class="fa-solid fa-earth-americas"></i></div>
                <p>All</p>
            </div>
        </a>
        <a href="/listings?category=Trending" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Trending' ? 'active' : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
        </a>
        <a href="/listings?category=Rooms" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Rooms' ? 'active' : '' %>">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Iconic Cities' ? 'active' : '' %>">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </div>
        </a>
        <a href="/listings?category=Mountains" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Mountains' ? 'active' : '' %>">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
        </a>
        <a href="/listings?category=Castles" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Castles' ? 'active' : '' %>">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
        </a>
        <a href="/listings?category=Amazing pools" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Amazing pools' ? 'active' : '' %>">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing pools</p>
            </div>
        </a>
        <a href="/listings?category=Camping" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Camping' ? 'active' : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
        </a>
        <a href="/listings?category=Farms" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Farms' ? 'active' : '' %>">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </div>
        </a>
        <a href="/listings?category=Arctic" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Arctic' ? 'active' : '' %>">
                <div><i class="fa-solid fa-snowflake"></i></div>
                <p>Arctic</p>
            </div>
        </a>
        <a href="/listings?category=Dome" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Dome' ? 'active' : '' %>">
                <div><i class="fa-solid fa-igloo"></i></div>
                <p>Dome</p>
            </div>
        </a>
        <a href="/listings?category=Houseboats" class="filter-link" style="text-decoration: none;">
            <div class="filter <%= typeof pageMeta !== 'undefined' && pageMeta.categoryQuery === 'Houseboats' ? 'active' : '' %>">
                <div><i class="fa-solid fa-ship"></i></div>
                <p>Houseboats</p>
            </div>
        </a>
    </div>
</div>

<div id="search-meta-container" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <% if (typeof pageMeta !== 'undefined' && pageMeta.searchQuery) { %>
        <p class="search-meta mb-0"><%= allListings.length %> stay<%= allListings.length === 1 ? "" : "s" %> for “<%= pageMeta.searchQuery %>”</p>
    <% } else { %>
        <p class="search-meta mb-0"></p>
    <% } %>
    <div class="tax-toggle mb-0">
        <label class="bor" for="switchCheckDefault">
            <span class="me-3">Display total after taxes</span>
            <div class="form-check form-switch m-0 p-0 d-flex align-items-center">
                <input class="form-check-input m-0 fs-5" type="checkbox" role="switch" id="switchCheckDefault" style="cursor: pointer;">
            </div>
        </label>
    </div>
</div>

<div id="listings-main-container">
    <% for (let group of Object.keys(groupedListings)) { %>
        <% if (groupedListings[group].length > 0) { %>
            <div class="group-section mt-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                    <h2 class="fs-4 fw-bold mb-0">Stay in <%= group %></h2>
                </div>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 listing-grid mt-2">
                    <% for (let listing of groupedListings[group]) { %>
                    <div class="col">
                        <a href="/listings/<%=listing._id%>" class="listing-link">
                            <div class="card listing-card">
                                <div class="card-img-wrap position-relative">
                                    <img src="<%=listing.image.url%>" class="card-img-top" alt="<%= listing.title %>">
                                    <div class="position-absolute top-0 start-0 w-100 p-2 d-flex justify-content-between align-items-start">
                                        <span class="badge text-dark rounded-pill shadow-sm px-2 py-1 fw-semibold" style="background: rgba(255,255,255,0.85); backdrop-filter: blur(4px); font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.4);">Guest favourite</span>
                                        <i class="fa-regular fa-heart text-white fs-5" style="filter: drop-shadow(0px 1px 3px rgba(0,0,0,0.6)); cursor: pointer; transition: transform 0.2s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'"></i>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h3 class="card-title fw-bold mb-0 text-truncate"><%= listing.title %></h3>
                                        <span class="ms-2 d-flex align-items-center" style="font-size: 0.9rem; color: var(--text);"><i class="fa-solid fa-star fa-xs me-1"></i>5.0</span>
                                    </div>
                                    <p class="card-location text-muted mb-1"><%= listing.location %>, <%= listing.country %></p>
                                    <p class="card-price mb-0">
                                        <b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b> <span class="text-muted">/ night</span>
                                        <i class="tax-info">&nbsp;+18% GST</i>
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% } %>
                </div>
            </div>
        <% } %>
    <% } %>

    <% if (allListings.length === 0) { %>
        <p class="text-center text-muted mt-5 mb-5">No listings match your search. Try another destination.</p>
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for (let info of taxInfo) {
            info.style.display = info.style.display === "inline" ? "none" : "inline";
        }
    });
</script>
