<% layout("/layouts/boilerplate") %>

<div class="form-shell">
    <h3>Create a new listing</h3>
    <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="form-floating mb-3">
            <input id="title" name="listing[title]" placeholder="Add a catchy title" type="text" required class="form-control">
            <label for="title">Title</label>
            <div class="invalid-feedback">Enter a valid title</div>
        </div>

        <div class="form-floating mb-3">
            <textarea id="description" name="listing[description]" class="form-control" placeholder="Description" style="height: 100px" required></textarea>
            <label for="description">Description</label>
            <div class="invalid-feedback">Enter a short description</div>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label ms-1">Upload listing image</label>
            <input name="listing[image]" id="image" type="file" class="form-control" required>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <div class="form-floating">
                    <input id="price" name="listing[price]" placeholder="1200" type="number" min="0" class="form-control" required>
                    <label for="price">Price</label>
                    <div class="invalid-feedback">Enter a valid Price</div>
                </div>
            </div>
            <div class="mb-3 col-md-8">
                <div class="form-floating">
                    <input id="country" name="listing[country]" placeholder="India" type="text" class="form-control" required>
                    <label for="country">Country</label>
                    <div class="invalid-feedback">Enter a valid country name</div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-8">
                <div class="form-floating">
                    <input id="location" name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required>
                    <label for="location">Location</label>
                    <div class="invalid-feedback">Enter a valid location</div>
                </div>
            </div>
            <div class="mb-3 col-md-4">
                <div class="form-floating">
                    <select id="category" name="listing[category]" class="form-select" required>
                        <option value="Trending">Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">Castles</option>
                        <option value="Amazing pools">Amazing pools</option>
                        <option value="Camping">Camping</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Dome">Dome</option>
                        <option value="Houseboats">Houseboats</option>
                    </select>
                    <label for="category">Category</label>
                </div>
            </div>
        </div>

        <button class="btn add-btn mt-3 btn-lg">Add listing</button>
    </form>
</div>
