<% layout("/layouts/boilerplate") %>

<div class="form-shell form-shell-sm">
    <h1 class="h3 text-center">Log in</h1>
    <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="form-floating mb-3">
            <input id="username" name="username" type="text" placeholder="Username" required class="form-control">
            <label for="username">Username</label>
        </div>
        <div class="form-floating mb-3">
            <input id="password" name="password" type="password" placeholder="Password" required class="form-control">
            <label for="password">Password</label>
        </div>
        <div class="d-grid mt-4">
            <button class="btn btn-brand btn-lg">Log in</button>
        </div>
    </form>
    <p class="text-center text-muted mt-3 mb-0 small">New here? <a href="/signup">Create an account</a></p>
</div>
