<% layout("/layouts/boilerplate") %>

<div class="form-shell form-shell-sm">
    <h1 class="h3 text-center">Sign up on Wanderlust</h1>
    <form action="/signup" method="POST" class="needs-validation" novalidate>
        <div class="form-floating mb-3">
            <input id="username" name="username" type="text" placeholder="Username" required class="form-control">
            <label for="username">Username</label>
            <div class="valid-feedback">Looks good!</div>
        </div>
        <div class="form-floating mb-3">
            <input id="email" name="email" type="email" placeholder="Email" required class="form-control">
            <label for="email">Email</label>
        </div>
        <div class="form-floating mb-3">
            <input id="password" name="password" type="password" placeholder="Password" required class="form-control">
            <label for="password">Password</label>
        </div>
        <div class="d-grid mt-4">
            <button class="btn btn-brand btn-lg">Sign up</button>
        </div>
    </form>
    <p class="text-center text-muted mt-3 mb-0 small">Already have an account? <a href="/login">Log in</a></p>
</div>
